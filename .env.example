# Postgres (Neon via Vercel). `vercel env pull .env.local` fills these.
# DATABASE_URL is pooled, for the app; DATABASE_URL_UNPOOLED is for migrations.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Concordium adapters. Unset = off: no registry check, sign-in or payments.
# "dev" = stand-ins that accept fake payments; refused on Vercel production.
CONCORDIUM_MODE=
DEV_CONCORDIUM_SECRET=
CONCORDIUM_GRPC_URL=https://grpc.testnet.concordium.com:20000

# Payout accounts. Workers and agents carry their own; these cover boreal and reviewers.
OPERATING_ACCOUNT_ADDRESS=
# ref=address pairs, comma-separated
REVIEWER_ADDRESSES=

# Signs worker session cookies (32+ characters). Needed once worker sign-in is on.
SESSION_SECRET=

# Private Blob store for submission files (set by the Vercel Blob integration)
BLOB_READ_WRITE_TOKEN=

# AI reviewer (screening and result review). Unset key = tasks wait for human reviewers.
ANTHROPIC_API_KEY=
BRAIN_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
BRAIN_EFFORT=high

# Authorizes /api/cron/tick (32+ characters)
CRON_SECRET=

# Monitor loop interval in milliseconds
MONITOR_INTERVAL_MS=30000
