# Postgres (Neon via Vercel). `vercel env pull .env.local` fills these.
# DATABASE_URL is pooled, for the app; DATABASE_URL_UNPOOLED is for migrations.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Concordium adapters. Unset = off: no registry check, sign-in or payments.
# "dev" = stand-ins that accept fake payments; refused on Vercel production.
CONCORDIUM_MODE=
DEV_CONCORDIUM_SECRET=
CONCORDIUM_GRPC_URL=https://grpc.testnet.concordium.com:20000

# Concordium ID App sign-in (Verify & Access). All three needed to turn it on.
NEXT_PUBLIC_REOWN_PROJECT_ID=
CONCORDIUM_ANCHOR_ACCOUNT=
# Private signing key (hex) of the anchor account; keep it in Vercel, never in git
CONCORDIUM_ANCHOR_KEY=
CONCORDIUM_NETWORK=testnet
# Keys worker pseudonyms (32+ characters). Never change it, or every worker becomes a new one
CONCORDIUM_PSEUDONYM_SECRET=

# PayPal rail (sandbox only). PAYMENTS_RAIL=paypal funds tasks with PayPal Orders (held as
# authorizations, captured or voided when the task is final) and pays workers with Payouts.
# Refused on Vercel production. For `pnpm dev:local` and the sandbox loop script, put these in
# .env.paypal at the workspace root instead (gitignored); never commit credentials.
PAYMENTS_RAIL=
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook id from the sandbox app's webhook settings, for /api/paypal/webhook
PAYPAL_WEBHOOK_ID=
# The first approved order saves the owner's PayPal account (vaulting), so the agent funds later
# tasks with no approval page. Needs the Vault option on the PayPal app; set to off without it.
PAYPAL_VAULT=
# Where PayPal returns the payer after approving (default http://localhost:3000)
PUBLIC_URL=
# Sandbox personal accounts that receive payouts in the sandbox loop and dev:local
PAYPAL_SANDBOX_WORKER_EMAIL=
PAYPAL_SANDBOX_REVIEWER_EMAIL=

# Payout accounts. Workers and agents carry their own; these cover boreal and reviewers.
OPERATING_ACCOUNT_ADDRESS=
# ref=address pairs, comma-separated
REVIEWER_ADDRESSES=

# Signs worker session cookies (32+ characters).
SESSION_SECRET=
# Invite code for test workers on /signin; unset = test sign-in off
TEST_WORKER_INVITE=

# Private Blob store for submission files (set by the Vercel Blob integration)
BLOB_READ_WRITE_TOKEN=

# AI reviewer (screening and result review). Unset key = tasks wait for human reviewers.
ANTHROPIC_API_KEY=
BRAIN_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
BRAIN_EFFORT=high

# Authorizes /api/cron/tick (32+ characters)
CRON_SECRET=

# Monitor loop interval in milliseconds
MONITOR_INTERVAL_MS=30000
