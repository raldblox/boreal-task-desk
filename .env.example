# Postgres connection used by apps/web and apps/worker
DATABASE_URL=postgres://boreal:boreal@localhost:5432/boreal

# Concordium (testnet for Phase 0)
CONCORDIUM_NETWORK=testnet
CONCORDIUM_GRPC_URL=https://grpc.testnet.concordium.com:20000
# Escrow and operating accounts; keys live in a secret manager, never in this file
ESCROW_ACCOUNT_ADDRESS=
OPERATING_ACCOUNT_ADDRESS=

# AI brain and reviewer
ANTHROPIC_API_KEY=
BRAIN_MODEL=claude-sonnet-5-5

# Monitor loop interval in milliseconds
MONITOR_INTERVAL_MS=30000
